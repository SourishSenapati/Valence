# Valence — Environment Variables Template
# Copy to .env and fill in the real values.

# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://postgres:password@localhost:5432/valence?schema=public"

# --- NextAuth.js ---
NEXTAUTH_SECRET="REPLACE_WITH_A_STRONG_RANDOM_SECRET"
NEXTAUTH_URL="http://localhost:3000"

# --- Azure AD (Entra ID) ---
AZURE_AD_CLIENT_ID="REPLACE_WITH_CLIENT_ID"
AZURE_AD_CLIENT_SECRET="REPLACE_WITH_CLIENT_SECRET"
AZURE_AD_TENANT_ID="REPLACE_WITH_TENANT_ID"

# Mapping of Azure AD Group IDs to Prisma Roles (Optional simulation)
# Format: GROUP_ID:ROLE
AZURE_AD_HR_ADMIN_GROUP_ID=""
AZURE_AD_PLANT_HEAD_GROUP_ID=""
AZURE_AD_SHIFT_MANAGER_GROUP_ID=""
